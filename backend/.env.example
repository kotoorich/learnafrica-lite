# ================================================================
# LearnAfrica Lite — Backend Environment Variables
# ================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# Then fill in your values.
# NEVER commit .env to git.
# ================================================================

# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-64-char-random-string
JWT_SECRET=change-this-to-another-64-char-random-string

# Database
# Local dev:    leave empty (uses SQLite automatically)
# Production:   paste your Neon connection string here
DATABASE_URL=

# CORS — which frontend URLs are allowed to call this API
# Local dev:    http://localhost:5173
# Production:   https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Supabase Storage (for file uploads)
# Leave empty in dev to use local file system
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=learnafrica-uploads

# Admin account (created automatically on first run)
ADMIN_EMAIL=admin@learnafrica.com
ADMIN_PASSWORD=Admin@LearnAfrica2024!

# Optional tuning
JWT_EXPIRATION_HOURS=24
QUIZ_PASS_SCORE=70
