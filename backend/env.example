# ── LearnAfrica backend — local development ──────────────────────────────
# Copy to backend/.env and fill in. NEVER commit the real .env.

# Signing secrets (required in production; a dev default is used locally)
SECRET_KEY=change-me-to-a-long-random-string
# JWT_SECRET=optional-override-for-secret-key

# Allowed frontend origins, comma-separated
ALLOWED_ORIGINS=http://localhost:5173

# ── Payments ─────────────────────────────────────────────────────────────
# REQUIRED in production. Without it the app refuses to start rather than
# silently accepting free "mock" purchases.
PAYSTACK_SECRET_KEY=

# ── Email OTP via SendPulse (used for signup verification) ───────────────
# All three of ID / secret / sender email are required for OTP emails to send.
# Get ID + secret from SendPulse → Account → API (see SETUP_SENDPULSE.md).
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
# A sender address you have added and verified in SendPulse
# (SendPulse → Settings → Senders / Email → "From" addresses).
SENDPULSE_SENDER_EMAIL=
SENDPULSE_SENDER_NAME=LearnAfrica

# ── Database (Postgres / Neon) ───────────────────────────────────────────
DATABASE_URL=
